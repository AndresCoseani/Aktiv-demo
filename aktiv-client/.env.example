# Variables del frontend. Copiá este archivo a .env.local y completalo.

# Dónde corre la API de NestJS (backend/). Next reenvía /api/* hasta acá; el
# navegador nunca la ve y no hace falta ninguna clave de Supabase en el frontend.
# En desarrollo: http://localhost:4000. En producción: la URL pública de la API
# (sin barra final), antes del primer build.
API_URL=http://localhost:4000

# Dirección pública que se le pasa a los alumnos en el mensaje de acceso (opcional).
# Por defecto es https://aktiv-running.vercel.app; cambiala si usás un dominio propio.
# NEXT_PUBLIC_APP_URL=https://aktiv-running.vercel.app
