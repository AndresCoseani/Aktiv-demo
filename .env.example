# Variables del frontend. Copiá este archivo a .env.local y completalo.
# Sin NEXT_PUBLIC_MODO la app arranca en modo demo (datos falsos en el navegador, sin servidor).
# NEXT_PUBLIC_* se inyectan al compilar: si las cambiás hay que volver a hacer build/deploy.

# Modo con datos reales: el frontend habla con la API de NestJS (backend/).
NEXT_PUBLIC_MODO=api

# Dónde corre la API. Next reenvía /api/* hasta acá; el navegador nunca la ve.
# En desarrollo: http://localhost:4000. En producción: la URL pública de la API.
API_URL=http://localhost:4000

# El frontend ya NO necesita ninguna clave de Supabase: todo pasa por la API.
