{
  "name": "aktiv-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Aktiv (NestJS). Autentica con Supabase Auth y accede a la base como el usuario, así que las políticas RLS siguen valiendo.",
  "scripts": {
    "contrato": "npm run build -w @aktiv/contrato",
    "build": "npm run contrato && nest build",
    "start": "node dist/main.js",
    "start:dev": "npm run contrato && nest start --watch",
    "typecheck": "npm run contrato && tsc --noEmit -p tsconfig.json",
    "test": "npm run contrato && jest && npm run test -w @aktiv/contrato",
    "test:e2e": "npm run contrato && jest --config test/jest-e2e.json --runInBand",
    "test:db": "node --env-file=test/.env.test scripts/probar-seguridad.mjs",
    "usuarios": "node --env-file=.env.seed scripts/crear-usuarios.mjs"
  },
  "dependencies": {
    "@aktiv/contrato": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "@types/node": "^22.20.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "diagnostics": false
        }
      ]
    },
    "testEnvironment": "node"
  },
  "workspaces": [
    "contrato"
  ]
}
