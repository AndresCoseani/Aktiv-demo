# Variables de la API. Copiá este archivo a .env y completalo.
# .env NO se sube a git (el .gitignore ignora .env*).

# Proyecto de Supabase: Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PÚBLICA (publishable / anon): Project Settings → API Keys.
# La API accede a la base como el usuario que inició sesión (RLS incluido).
SUPABASE_ANON_KEY=

# Clave SECRET (service_role): Project Settings → API Keys. Es poderosa: se salta RLS.
# Solo la usa el módulo de invitaciones/cuentas (crear la cuenta de un alumno, borrarla,
# consumir el enlace) y SIEMPRE después de comprobar que el profe es dueño del alumno.
# Sin esta clave la API arranca igual, pero no se puede invitar ni eliminar cuentas.
SUPABASE_SERVICE_ROLE_KEY=

# Mails de invitación (Resend). Sin RESEND_API_KEY y MAIL_FROM, en desarrollo el mail
# se imprime en la consola de la API (con el enlace); en producción la invitación falla
# con un mensaje claro.
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend, p. ej.: Aktiv <aktiv@tudominio.com>
MAIL_FROM=
# URL pública del frontend, para armar el enlace del mail (por defecto, el primer WEB_ORIGIN)
APP_URL=
# Días de vida del enlace y tope de invitaciones por alumno por hora (opcionales)
INVITACION_DIAS=7
INVITACIONES_POR_HORA=5

# Puerto de la API
PORT=4000
NODE_ENV=development

# Dónde corre el frontend (CORS y verificación anti-CSRF). Varios, separados por coma.
WEB_ORIGIN=http://localhost:3000

# Detrás de un proxy (Render, Fly, etc.) poné cuántos hay (normalmente 1) para leer la IP real.
TRUST_PROXY=0

# Límites (opcionales)
RATE_LIMIT_PER_MIN=300
LOGIN_FALLOS_POR_MIN=8
