{
  "name": "aktiv_prototipe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "contrato": "npm run build -w @aktiv/contrato",
    "typecheck": "tsc --noEmit",
