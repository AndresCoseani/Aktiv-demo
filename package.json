    "build:api": "npm run contrato && npm run build -w @aktiv/backend",
    "test:api": "npm run contrato && npm run test:e2e -w @aktiv/backend",
    "typecheck:api": "npm run contrato && npm run typecheck -w @aktiv/backend"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "@aktiv/contrato": "*"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "@supabase/supabase-js": "^2.118.0"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ]
