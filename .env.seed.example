# Copiá este archivo a .env.seed y completalo. .env.seed NO se sube a git.
# Se usa solo en tu compu, con:  node --env-file=.env.seed scripts/crear-usuarios.mjs

# Proyecto de Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave SECRETA (secret / service_role). Nunca la pongas en el frontend, en la API ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Profe
PROFE_EMAIL=
PROFE_PASSWORD=
PROFE_NOMBRE=Lucas

# Alumno (se crea vinculado a ese profe)
ALUMNO_EMAIL=
ALUMNO_PASSWORD=
ALUMNO_NOMBRE=Andres Coseani

# Contraseñas de menos de 8 caracteres en un proyecto en internet: hay que pedirlo a propósito.
# Supabase Auth exige 6 caracteres como mínimo absoluto. Solo para demos; cambialas antes de usar datos reales.
# PERMITIR_CLAVES_DEBILES=true
