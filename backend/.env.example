# Variables de la API. Copiá este archivo a backend/.env y completalo.
# backend/.env NO se sube a git (el .gitignore de la raíz ignora .env*).

# Proyecto de Supabase: Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PÚBLICA (publishable / anon): Project Settings → API Keys.
# La API accede a la base como el usuario que inició sesión, así que usa solo esta clave.
# NO pongas acá la clave secret / service_role.
SUPABASE_ANON_KEY=

# Puerto de la API
PORT=4000
NODE_ENV=development

# Dónde corre el frontend (CORS y verificación anti-CSRF). Varios, separados por coma.
WEB_ORIGIN=http://localhost:3000

# Detrás de un proxy (Render, Fly, etc.) poné cuántos hay (normalmente 1) para leer la IP real.
TRUST_PROXY=0

# Límites (opcionales)
RATE_LIMIT_PER_MIN=300
LOGIN_FALLOS_POR_MIN=8
